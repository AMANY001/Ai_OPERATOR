# Optional. The demo works without a Gemini key using deterministic planning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Paths are relative to the project root unless absolute.
DATABASE_PATH=state.db
OUTPUT_DIR=output

# Set to 1 only when demonstrating the spreadsheet failure/recovery scenario.
SIMULATE_SHEET_FAILURE=0
MAX_RETRIES=3
STEP_TIMEOUT_SECONDS=60
TASK_TIMEOUT_SECONDS=900

# Local writes are approval-gated in the UI. These remain enabled by default.
APPROVAL_REQUIRED_FOR_FILE_WRITES=1
APPROVAL_REQUIRED_FOR_EXTERNAL_ACTIONS=1
APPROVAL_REQUIRED_FOR_FINANCIAL_ACTIONS=1
